# Clawback configuration. Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible endpoint; confirm base URL and model names in the Nebius docs)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Tavily
TAVILY_API_KEY=
# Jurisdiction used when searching consumer-protection rules (undecided: set before the demo)
POLICY_JURISDICTION=

# App
DATABASE_PATH=./clawback.db
DEMO_TODAY=2026-10-27
RECORDED_MODE=false
CACHE_DIR=./.cache

# Thresholds (defaults match app/rules.py)
UNUSED_DAYS=90
HOT_DEADLINE_DAYS=7
MINUTES_SAVED_PER_CANCEL=60
MINUTES_SAVED_PER_CLAIM=120

PORT=8000
