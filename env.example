# Clawback configuration. Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible)
# Create a key at https://tokenfactory.nebius.com → set NEBIUS_API_KEY
# Docs: https://docs.tokenfactory.nebius.com/quickstart
# Cookbook: https://github.com/nebius/token-factory-cookbook
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily — POST https://api.tavily.com/search (Bearer). Docs: https://docs.tavily.com
TAVILY_API_KEY=
# Jurisdiction appended to consumer-protection / return-policy search queries
POLICY_JURISDICTION=US

# App
DATABASE_PATH=./clawback.db
DEMO_TODAY=2026-10-27
RECORDED_MODE=false
CACHE_DIR=./.cache

# Public demo (safe defaults: reset off, no job token)
DEMO_RESET=              # set to "enabled" to allow POST /api/demo/reset
JOB_TOKEN=               # when set, POST /api/jobs/scan requires X-Job-Token
LIVE_LLM_DAILY_LIMIT=300
UPLOAD_MAX_BYTES=1000000
SCAN_TARGET_URL=         # when set, jobs/scan.py POSTs the remote /api/jobs/scan
LIVE_API_RATE_LIMIT=30
LIVE_API_RATE_WINDOW_S=60

# Thresholds (defaults match app/rules.py)
UNUSED_DAYS=90
HOT_DEADLINE_DAYS=7
MINUTES_SAVED_PER_CANCEL=60
MINUTES_SAVED_PER_CLAIM=120

PORT=8000
